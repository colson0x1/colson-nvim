###
# Upload file with multipart form data
POST http://localhost:3000/api/v1/uploads/profile-image
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6ImNvbHNvbjB4MSIsImlhdCI6MTUxNjIzOTAyMn0
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="metadata"
Content-Type: application/json

{
  "filename": "profile.jpg",
  "contentType": "image/jpeg",
  "userId": "12345",
  "tags": ["profile", "avatar"],
  "uploadedBy": "colson0x1",
  "uploadDate": "2025-03-28T07:08:05Z"
}
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="profile.jpg"
Content-Type: image/jpeg

< ./uploads/profile.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

