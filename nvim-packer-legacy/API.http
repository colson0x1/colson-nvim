###
# Analytics API
###

# Get user engagement metrics
POST http://localhost:3000/api/v1/analytics/engagement
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6ImNvbHNvbjB4MSIsImlhdCI6MTUxNjIzOTAyMn0
X-Data-Partition: user-behavior

{
  "timeRange": {
    "start": "2025-01-01T00:00:00Z",
    "end": "2025-03-28T07:08:05Z"
  },
  "dimensions": ["device", "country", "userType"],
  "metrics": ["sessionDuration", "pageViews", "conversionRate"],
  "filters": [
    {
      "dimension": "userType",
      "operator": "IN",
      "values": ["new", "returning"]
    }
  ],
  "sampling": {
    "enabled": true,
    "rate": 0.1
  }
}

