  "operations": [
    {
      "operation": "CREATE",
      "data": {
        "name": "Stillhome",
        "email": "stillhome@typemuse.com"
      }
    },
    {
      "operation": "UPDATE",
      "id": "12345",
      "data": {
        "preferences": {
          "theme": "system"
        }
      }
    },
    {
      "operation": "DELETE",
      "id": "54321"
    }
  ],
  "options": {
    "continueOnError": true,
