###
# User Management API
###

# Create a new user
POST http://localhost:3000/api/v1/users
Content-Type: application/json
X-Request-ID: 7b8f9e2a-1c3d-4a5b-9e8f-7c6d5a4b3e2d
X-API-Version: 1.0

{
  "name": "Colson",
  "email": "colson@typemuse.com",
  "currentYear": "2025",
  "age": 26,
  "preferences": {
    "theme": "dark",
    "notifications": true,
    "timezone": "UTC-7"
  },
  "roles": ["user", "beta-tester"]
}

